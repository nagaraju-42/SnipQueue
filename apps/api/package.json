    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.9.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
